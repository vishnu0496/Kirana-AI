# ── WhatsApp Cloud API (the only external service) ─────────────────
# Access token from Meta for Developers (temporary or permanent).
WHATSAPP_TOKEN="YOUR_WHATSAPP_TOKEN"

# The ID of your WhatsApp phone number from Meta for Developers.
WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"

# A secret string you choose; Meta echoes it during webhook verification.
WHATSAPP_VERIFY_TOKEN="KIRANA_SECRET"

# App Secret from Meta for Developers; verifies x-hub-signature-256 on
# incoming webhooks. Strongly recommended in production.
WHATSAPP_APP_SECRET="YOUR_WHATSAPP_APP_SECRET"

# ── Optional ────────────────────────────────────────────────────────
# PORT=3000
# DATA_DIR=./data                # where store.json lives
# LOW_STOCK_THRESHOLD=5

# Billing is fully local (no payment gateway). Disabled by default.
# BILLING_ENABLED=true
# TRIAL_DAYS=7
# ADMIN_PHONE=91XXXXXXXXXX       # can send "activate <phone>" / "deactivate <phone>"
# MERCHANT_UPI_ID=yourname@upi   # appended as a upi:// link in trial-expired messages
# SUPPORT_CONTACT=+91 XXXXX XXXXX
